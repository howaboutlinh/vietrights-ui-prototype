GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.6-flash
GEMINI_FALLBACK_MODEL=
GEMINI_EMBEDDING_MODEL=gemini-embedding-001

# Supabase PostgreSQL Session Pooler URL. Use a URL-encoded password.
# postgresql+psycopg://postgres.PROJECT:PASSWORD@POOLER_HOST:5432/postgres?sslmode=require
DATABASE_URL=

KNOWLEDGE_SOURCE_1=
KNOWLEDGE_SOURCE_2=
KNOWLEDGE_SOURCE_3=
KNOWLEDGE_SOURCE_4=

RAG_MATCH_COUNT=6
RAG_MATCH_THRESHOLD=0.60
EMBEDDING_DIMENSION=768
HTTP_REQUEST_TIMEOUT_SECONDS=30
CRAWL_MAX_DEPTH=2
CRAWL_MAX_PAGES=40
